extends "res://tests/test_runner.gd"

var save_announcements: int = 0

func _ready() -> void:
	visual_test = "--visual" in OS.get_cmdline_user_args()
	Engine.max_fps = (30 if "--limit-30" in OS.get_cmdline_user_args() else 60) if visual_test else 0
	SaveManager.save_completed.connect(func(): save_announcements += 1)
	GameState.new_journey()
	var phone := PhoneDataService.new()
	add_child(phone)
	var ids: Array = []
	for message in phone.messages:
		check(not message.id in ids and message.delay_seconds >= 0, "Unique message ID and nonnegative authored delay: " + message.id)
		ids.append(message.id)
	check(phone.received_messages().is_empty(), "Fresh journey has no delivered messages")
	GameState.set_flag("story.prologue.laid_off")
	GameState.set_flag("story.prologue.departed")
	check(GameState.phone.pending.size() == 3, "Story conditions schedule three messages")
	phone.advance(1, true, false)
	GameState.set_flag("story.prologue.laid_off")
	check(GameState.phone.pending.dimas == 1, "Repeated flag does not restart delay or duplicate message")
	var locked := GameState.phone.duplicate(true)
	phone.advance(100, false, true)
	check(GameState.phone == locked, "Delivery lock freezes delays and banners")
	SaveManager.save_game(false)
	GameState.phone.pending.dimas = 99
	SaveManager.load_game()
	check(GameState.phone.pending.dimas == 1, "Remaining delay survives checkpoint save/load")
	var notice := phone.advance(1, true, false)
	check(notice.is_empty() and GameState.phone.delivered == ["dimas"], "Message arrives after delay even while banner slot is busy")
	phone.advance(3, true, false)
	check(GameState.phone.delivered == ["dimas", "mom_departure"], "Inbox preserves actual delivery order")
	notice = phone.advance(2, true, true)
	check(notice.get("id") == "dimas" and GameState.phone.notified == ["dimas"], "Only oldest waiting banner is selected")
	check(phone.unread_count() == 3, "Unread count includes delivered messages only")
	check(save_announcements == 0, "Phone autosaves do not replace banners with checkpoint toasts")
	SaveManager.load_game()
	notice = phone.advance(0, true, true)
	check(notice.get("id") == "mom_departure", "Reload does not replay already displayed banner")
	var inbox := phone.received_messages()
	inbox[0].text = "Changed outside service"
	check(phone.message_by_id("dimas").text != "Changed outside service", "UI receives independent message copies")
	check(not phone.reply("dad") and not phone.reply("unknown"), "Cannot reply to unavailable messages")
	phone.mark_inbox_read()
	check(phone.unread_count() == 0 and phone.advance(0, true, true).is_empty(), "Opening inbox suppresses remaining banners for read messages")
	check(phone.reply("recruiter"), "Authored reply saves successfully")
	check(GameState.flags.get("phone.recruiter.replied", false), "Reply commits its namespaced flag")
	check(not phone.reply("recruiter"), "Repeated reply cannot duplicate state")
	SaveManager.load_game()
	check(GameState.phone.read.size() == 3 and GameState.phone.replies.has("recruiter"), "Read state and reply survive reload")
	var legacy := GameState.snapshot()
	legacy.phone = {"read": ["mom_departure"], "replies": {"dimas": "Thanks."}}
	check(SaveManager.validate(legacy), "Pre-queue v1 save remains valid")
	var migrated := SaveManager.migrate(legacy)
	check(migrated.phone.delivered == ["mom_departure", "dimas"] and migrated.phone.notified == migrated.phone.delivered, "Legacy read/replied messages migrate without repeated notifications")
	GameState.restore(migrated)
	check(phone.unread_count() == 0 and GameState.phone.pending.has("recruiter"), "Unread legacy message schedules without losing old conversation history")
	for invalid in [{"pending": []}, {"pending": {"dad": -1}}, {"pending": {"dad": INF}}, {"pending": {"dad": "soon"}}, {"delivered": {}}, {"notified": [9]}, {"read": [false]}]:
		var broken := GameState.snapshot()
		broken.phone.merge(invalid, true)
		check(not SaveManager.validate(broken), "Malformed phone delivery state rejected: " + str(invalid))
	GameState.new_journey()
	check(GameState.phone.pending.is_empty() and GameState.phone.delivered.is_empty(), "New journey clears all notification history")
	GameState.set_flag("story.prologue.laid_off")
	GameState.set_flag("story.prologue.departed")
	phone.advance(30, true, false)
	check(GameState.phone.delivered == ["dimas", "mom_departure", "recruiter"], "Large elapsed step still orders deliveries by due time")
	GameState.bike.fuel = -1 # Force save validation failure without touching real user files.
	notice = phone.advance(0, true, true)
	check(notice.is_empty() and GameState.phone.notified.is_empty() and not SaveManager.last_error.is_empty(), "Failed autosave keeps notification pending and does not cover error toast")
	GameState.bike.fuel = 12
	notice = phone.advance(0, true, true)
	check(notice.get("id") == "dimas" and SaveManager.read_save().phone.notified == ["dimas"], "Notification retries successfully when saving becomes available")
	phone.free()
	GameState.new_journey()
	GameState.chapter = "karawang"
	GameState.checkpoint = "road_start"
	app = preload("res://scenes/boot/Boot.tscn").instantiate()
	add_child(app)
	await frames(4)
	app.set_process(false) # Deterministic scheduler steps; world/UI still render normally.
	await app._start_road(1100, false)
	GameState.set_flag("story.prologue.laid_off")
	GameState.set_flag("story.prologue.departed")
	locked = GameState.phone.duplicate(true)
	app.state = "cutscene"
	app.ui.show_cinematic("Opening", "Test", "A quiet moment.")
	app._process(20)
	check(GameState.phone == locked, "Boot cutscene gate blocks deliveries")
	app.state = "dialogue"
	app.ui.show_dialogue({"speaker": "Raka", "text": "A quiet moment.", "choices": []})
	app._process(20)
	check(GameState.phone == locked, "Boot dialogue gate blocks deliveries")
	app.state = "riding"
	app.ui.riding()
	app._pause()
	app._process(20)
	check(GameState.phone == locked, "Pause gate freezes delivery time")
	app._resume()
	app.flow.busy = true
	app._process(20)
	check(GameState.phone == locked, "Scene transition gate freezes delivery time")
	app.flow.busy = false
	app.ui.toast("A checkpoint status message")
	app._process(8)
	check(GameState.phone.delivered.size() == 3 and GameState.phone.notified.is_empty(), "Messages wait behind a visible status toast")
	check(app.ui.phone_button.text == "Phone (3)", "HUD badge reflects unread inbox")
	await frames(3)
	var toolbar_inside := true
	for button in app.ui.toolbar.get_children():
		toolbar_inside = toolbar_inside and app.ui.root.get_global_rect().encloses(button.get_global_rect())
	check(toolbar_inside, "Unread badge expansion keeps every HUD button inside the viewport")
	app.ui.toast_timer = 0
	app._process(0)
	check(app.ui.phone_toast and app.ui.toast_label.text.begins_with("Dimas"), "First queued banner appears on the riding HUD")
	var banner: String = app.ui.toast_label.text
	app._process(1)
	check(app.ui.toast_label.text == banner and GameState.phone.notified.size() == 1, "Next notice cannot overwrite an active banner")
	await capture("narrative_notification")
	app._pause()
	check(app.ui.toast_timer == 0 and not app.ui.toast_label.visible, "Opening a locked screen hides an active phone banner")
	app._resume()
	app._on_action("phone")
	check(app.ui.mode == "phone" and get_tree().paused and app.ui.phone_button.text == "Phone", "Phone pauses ride and marks delivered inbox read")
	await capture("narrative_inbox")
	check(SaveManager.read_save().phone.read.size() == 3, "Reading without replying persists immediately")
	app._resume()
	app._process(0)
	check(GameState.phone.notified.size() == 1, "Read messages do not reappear as queued banners")
	app.bike.teleport(1130)
	app._process(0)
	app._interact()
	complete_dialogue(0)
	check(GameState.checkpoint == "warung" and GameState.phone.pending.has("dad"), "Shelter encounter saves newly queued Dad message")
	app.ui.toast_timer = 0
	app._process(3)
	check(GameState.phone.delivered.has("dad") and app.ui.toast_label.text.begins_with("Dad"), "Shelter message arrives after authored delay")
	app._on_action("phone")
	check(app.phone_service.reply("dad"), "Encounter message supports saved reply")
	app._resume()
	app.bike.teleport(1700)
	app._process(0)
	app._interact()
	complete_dialogue(0)
	app._journal_selected("tea", "Someone made tea. I didn't have to explain much.")
	check(SaveManager.load_game() and GameState.checkpoint == "complete" and GameState.phone.replies.has("dad") and not GameState.journal.is_empty(), "Encounter, phone reply and journal survive combined save/reload")
	var snapshot := GameState.snapshot()
	var save_before := FileAccess.get_file_as_string(SaveManager.SAVE_PATH)
	var debug_enabled := OS.is_debug_build() and "--story-debug" in OS.get_cmdline_user_args()
	check(app.ui.story_debug_available() == debug_enabled, "Debug availability follows explicit startup opt-in")
	app._on_action("story_debug")
	if debug_enabled:
		check(app.ui.mode == "story_debug" and get_tree().paused, "Opt-in viewer opens with gameplay paused")
		check(app.ui._debug_flags("sheltered").contains("story.karawang.sheltered = true") and not app.ui._debug_flags("sheltered").contains("laid_off"), "Flag filter isolates matching names and values")
		check(app.ui._debug_flags("not_a_flag") == "No matching flags.", "Empty filter results are explicit")
		await capture("narrative_debug")
		app.ui.show_story_debug()
		check(GameState.snapshot() == snapshot and FileAccess.get_file_as_string(SaveManager.SAVE_PATH) == save_before, "Viewer and refresh never mutate state or save")
		app._on_action("back")
		app._resume()
	else:
		check(app.ui.mode != "story_debug" and not get_tree().paused, "Normal launch rejects debug action")
	GameState.new_journey()
	check(app.phone_service.unread_count() == 0 and GameState.phone.pending.is_empty(), "New journey resets a live boot service")
	get_tree().paused = false
	app.queue_free()
	await frames(3)
	print("NARRATIVE TEST RESULT: %d checks, %d failures" % [checks, failures])
	get_tree().quit(1 if failures else 0)
