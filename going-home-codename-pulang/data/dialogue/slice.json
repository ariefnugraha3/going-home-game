  "guesthouse": {
    "nodes": {
      "start": {
        "speaker": "Guesthouse owner",
        "text": "One night?",
        "next": "night",
        "text_keys": {
          "speaker": "dialogue.slice.guesthouse.nodes.start.speaker",
          "text": "dialogue.slice.guesthouse.nodes.start.text"
        }
      },
      "night": {
        "speaker": "Raka",
        "text": "Yes. Somewhere I can park the bike under a roof?",
        "next": "roof",
        "text_keys": {
          "speaker": "dialogue.slice.guesthouse.nodes.night.speaker",
          "text": "dialogue.slice.guesthouse.nodes.night.text"
        }
      },
      "roof": {
        "speaker": "Guesthouse owner",
        "text": "Right beside the kitchen. Tea in the morning, if you're up.",
        "next": "thanks",
        "text_keys": {
          "speaker": "dialogue.slice.guesthouse.nodes.roof.speaker",
          "text": "dialogue.slice.guesthouse.nodes.roof.text"
        }
      },
      "thanks": {
        "speaker": "Raka",
        "text": "That sounds good.",
        "next": "end",
        "text_keys": {
          "speaker": "dialogue.slice.guesthouse.nodes.thanks.speaker",
          "text": "dialogue.slice.guesthouse.nodes.thanks.text"
        }
      }
